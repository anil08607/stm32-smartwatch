{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"files": {
		"includes": [
			"**",
			"!.git",
			"!.tscircuit",
			"!dist",
			"!node_modules",
			"!__snapshots__",
			"!build",
			"!hardware",
			"!checks/vendor",
			"!docs/checks",
			"!routing/*.json",
			"!release",
			"!sourcing/stock.json",
			"!mechanical/*.json",
			"!mechanical/viewer.js"
		]
	},
	"formatter": {
		"indentStyle": "tab"
	}
}
